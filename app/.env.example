# Αντιγράψτε σε .env.local και συμπληρώστε.
# ΑΝ ΜΕΙΝΟΥΝ ΚΕΝΑ, η εφαρμογή τρέχει σε ΤΟΠΙΚΗ ΛΕΙΤΟΥΡΓΙΑ ΕΠΙΔΕΙΞΗΣ
# με ενσωματωμένα δοκιμαστικά δεδομένα (χωρίς βάση, χωρίς σύνδεση).
#
# Το ανώνυμο κλειδί (anon key) προορίζεται για χρήση στον browser: όλη η
# προστασία των δεδομένων ασκείται από τα Row Level Security policies και
# τη συνεδρία του χρήστη. ΠΟΤΕ μην τοποθετείτε εδώ το service-role κλειδί.

VITE_SUPABASE_URL=https://nubxaclmwuhqkvuvmvos.supabase.co
VITE_SUPABASE_ANON_KEY=

# Προαιρετικό: εξαναγκασμός λειτουργίας επίδειξης ακόμη κι αν υπάρχουν τα παραπάνω
# VITE_DEMO=1
