  {
    "doc_code": "PRAXH_MEIWSHS_EGG",
    "title": "Πράξη μείωσης εγγύησης καλής εκτέλεσης κατά 70%",
    "stage_code": "S28_MEIWSH_EGG",
    "legal_ref_id": "N4412/72/14b",
