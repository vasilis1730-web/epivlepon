  {
    "doc_code": "APOFASI_PARATASIS",
    "title": "Απόφαση χορήγησης παράτασης προθεσμίας",
    "stage_code": "S20_PARATASEIS",
    "legal_ref_id": "N4412/147/8",
    "subject_template": "Χορήγηση παράτασης της προθεσμίας περαίωσης των εργασιών του έργου «{{ergo.titlos}}»",
    "signatories": [
      {
        "label": "Ο Προϊστάμενος της Διευθύνουσας Υπηρεσίας",
