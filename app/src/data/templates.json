[
  {
    "doc_code": "APOFASI_ORISMOU",
    "title": "Απόφαση ορισμού επιβλέποντος",
    "stage_code": "S01_ORISMOS",
    "legal_ref_id": "N4412/136/2",
    "subject_template": "Ορισμός επιβλέποντος μηχανικού του έργου «{{ergo.titlos}}»",
    "signatories": [
      {
        "label": "Ο Προϊστάμενος της Διευθύνουσας Υπηρεσίας",
